PORT=5000

# To run locally WITHOUT Docker installed, you can use cloud hosted databases:
# 1. MongoDB Atlas cluster (free tier) for MONGO_URI
# 2. Upstash Redis (free tier) for REDIS_URI
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/interviewPrep?retryWrites=true&w=majority
REDIS_URI=redis://default:<password>@<upstash-endpoint>.upstash.io:6379

# Gemini AI Key for LLM service
GEMINI_API_KEY=your_gemini_api_key

# JWT Secret
JWT_SECRET=super_secret_jwt_string
